rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isContractor() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'contractor';
    }

    match /users/{uid} {
      // Allow user to read own doc, admins read all
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Allow self-signup: user can create their own doc with role 'contractor'
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'contractor';

      // User can update own profile fields, but cannot change role/email/createdAt
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
      );

      allow delete: if isAdmin();
    }

    match /contractors/{id} {
      allow read, write: if isAdmin();
    }

    match /inventory/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contacts/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /quotes/{id} {
      allow read: if isAdmin() ||
        (isContractor() && resource.data.contractorId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /quoteRequests/{id} {
      // Contractors can create their own quote requests, read their own
      allow create: if isSignedIn()
        && request.resource.data.contractorId == request.auth.uid;
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.contractorId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /supportMessages/{id} {
      // Contractors create their own messages, read their own
      allow create: if isSignedIn()
        && request.resource.data.contractorId == request.auth.uid;
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.contractorId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /orders/{id} {
      allow read: if isAdmin() ||
        (isContractor() && resource.data.contractorId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /invoices/{id} {
      allow read: if isAdmin() ||
        (isContractor() && resource.data.contractorId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /meta/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
